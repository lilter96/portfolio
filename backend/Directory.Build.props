<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;CA2007;CA1812;CA1848;CA1873;CA1002;CA1054;CA1056;CA1707;CA2234;CA1031</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Terentiy Gatsukov</Authors>
    <Company>lilter96</Company>
    <Copyright>© $(Authors) 2026</Copyright>
    <RepositoryUrl>https://github.com/lilter96/portfolio</RepositoryUrl>
  </PropertyGroup>

</Project>
