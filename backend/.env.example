# ── PostgreSQL ───────────────────────────────────────────────
# Connection string for the portfolio database.
# Format: Host=<host>;Port=<port>;Database=<db>;Username=<user>;Password=<pass>
CONNECTIONSTRINGS__POSTGRES=Host=localhost;Port=5432;Database=portfolio;Username=portfolio;Password=change_me

# ── Redis ────────────────────────────────────────────────────
# Connection string for Redis cache.
# Format: <host>:<port>
CONNECTIONSTRINGS__REDIS=localhost:6379

# ── ASP.NET ──────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5121
