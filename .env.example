# ──────────────────────────────────────────────────────────────
# Portfolio — Environment variables
# Copy to .env and adjust for your environment.
# Never commit .env to the repository.
# ──────────────────────────────────────────────────────────────

# ── ASP.NET ─────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio_dev

# ── Redis ───────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Frontend (local dev: API at 5121; Docker: empty = same-origin via nginx proxy) ──
VITE_API_BASE_URL=http://localhost:5121
